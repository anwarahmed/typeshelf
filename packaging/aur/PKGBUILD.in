# Maintainer: Anwar Ahmed <https://github.com/anwarahmed>
#
# Generated by packaging/aur/render.sh in https://github.com/anwarahmed/typeshelf
# for each release; edit the template there, not this file.

pkgname=typeshelf-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Practice typing in the terminal by retyping classic books"
arch=('x86_64' 'aarch64')
url="https://github.com/anwarahmed/typeshelf"
license=('MIT')
provides=('typeshelf')
conflicts=('typeshelf')
# The binaries are static and already stripped of debug info.
options=('!strip' '!debug')
source=("typeshelf-$pkgver-LICENSE::https://raw.githubusercontent.com/anwarahmed/typeshelf/v$pkgver/LICENSE")
source_x86_64=("typeshelf-$pkgver-x86_64::$url/releases/download/v$pkgver/typeshelf-x86_64-unknown-linux-musl")
source_aarch64=("typeshelf-$pkgver-aarch64::$url/releases/download/v$pkgver/typeshelf-aarch64-unknown-linux-musl")
sha256sums=('@SHA_LICENSE@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
    install -Dm755 "$srcdir/typeshelf-$pkgver-$CARCH" "$pkgdir/usr/bin/typeshelf"
    install -Dm644 "$srcdir/typeshelf-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
